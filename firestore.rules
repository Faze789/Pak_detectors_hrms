rules_version = '2';

// Permissive rule set: any signed-in user can read or write any document.
// Use this only while iterating on the app — it gives every employee account
// the ability to read other people's attendance, tasks, leaves, salaries,
// etc. Lock back down to per-role rules before shipping to real users.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
